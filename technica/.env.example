# Keys stay server-side. Copy to .env and enter your own new credentials.
GEMINI_API_KEY=
CAPITAL_ONE_API_KEY=

# Set to nessie only after confirming your key came from nessieisreal.com.
CAPITAL_ONE_PRODUCT=
# Optional model override; default is gemini-3.8-flash.
GEMINI_MODEL=
# Optional server settings; defaults: port 3000, localhost HTTP.
PORT=
COOKIE_SECURE=
