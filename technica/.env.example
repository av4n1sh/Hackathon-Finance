# Optional assistance. Both a key and an enabled model name are required.
# Keys stay server-side. Copy to .env only if it does not already exist.
GEMINI_API_KEY=
GEMINI_MODEL=
# Reviewer access is disabled until this is set to a random secret of 24+ characters.
REVIEWER_KEY=
# Optional server port, default 3000. The server binds to localhost.
PORT=
